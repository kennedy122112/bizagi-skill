{
  "name": "Atención de incidencias de TI",
  "doc": "Atender las incidencias de TI reportadas por los usuarios desde su registro en GLPI hasta el cierre del ticket y la encuesta de satisfacción, con escalamiento por niveles de soporte y control de SLA.",
  "meta": {"codigo": "PR-TI-003", "version": "0.1", "responsable": "Coordinación de TI", "area": "Tecnologías de la Información", "elaborado": "Analista de procesos", "fecha": "2026-10-26"},
  "pools": [
    {"name": "Área de TI", "lanes": ["Usuario", "Mesa de ayuda", "Soporte N1", "Soporte N2", "Coordinador de TI"]},
    {"name": "Proveedor externo", "blackbox": true}
  ],
  "nodes": [
    {"id": "inicio", "type": "start", "name": "Incidencia detectada", "lane": "Usuario"},
    {"id": "reportar", "type": "manualTask", "name": "Reportar incidencia", "lane": "Usuario",
     "doc": "El usuario reporta la incidencia por correo, teléfono o portal de autoservicio."},
    {"id": "registrar", "type": "userTask", "name": "Registrar ticket", "lane": "Mesa de ayuda",
     "doc": "La mesa de ayuda registra el ticket en GLPI."},
    {"id": "clasificar", "type": "userTask", "name": "Clasificar prioridad", "lane": "Mesa de ayuda",
     "doc": "Asigna prioridad crítica, alta, media o baja."},
    {"id": "atenderN1", "type": "userTask", "name": "Atender incidencia en N1", "lane": "Soporte N1",
     "doc": "El soporte de primer nivel intenta resolver la incidencia en un máximo de 30 minutos."},
    {"id": "t30", "type": "timer", "name": "30 min sin resolver", "attachedTo": "atenderN1", "timer": "PT30M"},
    {"id": "gwN1", "type": "exclusive", "name": "¿Resuelta en N1?", "lane": "Soporte N1"},
    {"id": "diagN2", "type": "userTask", "name": "Diagnosticar incidencia en N2", "lane": "Soporte N2",
     "doc": "Soporte especializado analiza la incidencia escalada o reabierta."},
    {"id": "tSLA", "type": "timer", "name": "SLA vencido", "attachedTo": "diagN2", "timer": "PT4H", "interrupting": false},
    {"id": "alertar", "type": "userTask", "name": "Revisar incidencia con SLA vencido", "lane": "Coordinador de TI",
     "doc": "El coordinador de TI recibe el aviso de vencimiento del SLA de una incidencia crítica y toma acciones."},
    {"id": "finSLA", "type": "end", "name": "Vencimiento atendido", "lane": "Coordinador de TI"},
    {"id": "gwHW", "type": "exclusive", "name": "¿Hardware en garantía?", "lane": "Soporte N2"},
    {"id": "enviarProv", "type": "sendTask", "name": "Enviar caso al proveedor", "lane": "Soporte N2"},
    {"id": "recibirProv", "type": "receiveTask", "name": "Recibir respuesta del proveedor", "lane": "Soporte N2"},
    {"id": "resolverN2", "type": "userTask", "name": "Resolver incidencia en N2", "lane": "Soporte N2"},
    {"id": "gwUneN2", "type": "exclusive", "name": "", "lane": "Soporte N2"},
    {"id": "pedirConf", "type": "userTask", "name": "Solicitar conformidad al usuario", "lane": "Mesa de ayuda"},
    {"id": "confirmar", "type": "userTask", "name": "Confirmar solución", "lane": "Usuario"},
    {"id": "t48", "type": "timer", "name": "48 h sin respuesta", "attachedTo": "confirmar", "timer": "PT48H"},
    {"id": "gwConf", "type": "exclusive", "name": "¿Incidencia resuelta?", "lane": "Usuario"},
    {"id": "cerrarAuto", "type": "serviceTask", "name": "Cerrar ticket automáticamente", "lane": "Mesa de ayuda"},
    {"id": "cerrar", "type": "userTask", "name": "Cerrar ticket", "lane": "Mesa de ayuda"},
    {"id": "gwUneCierre", "type": "exclusive", "name": "", "lane": "Mesa de ayuda"},
    {"id": "encuesta", "type": "serviceTask", "name": "Enviar encuesta de satisfacción", "lane": "Mesa de ayuda"},
    {"id": "fin", "type": "end", "name": "Incidencia cerrada", "lane": "Mesa de ayuda"},
    {"id": "glpi", "type": "dataStore", "name": "GLPI"},
    {"id": "ticket", "type": "dataObject", "name": "Ticket de incidencia"},
    {"id": "notaPrio", "type": "annotation", "text": "Prioridades: crítica, alta, media, baja. SLA de crítica: 4 h desde el registro."},
    {"id": "notaCanal", "type": "annotation", "text": "Canales: correo, teléfono o portal"}
  ],
  "flows": [
    "inicio -> reportar",
    "reportar -> registrar",
    "registrar -> clasificar",
    "clasificar -> atenderN1",
    "atenderN1 -> gwN1",
    "gwN1 -> pedirConf : Sí",
    "gwN1 -> diagN2 : No",
    "t30 -> diagN2",
    "tSLA -> alertar",
    "alertar -> finSLA",
    "diagN2 -> gwHW",
    "gwHW -> enviarProv : Sí",
    "gwHW -> resolverN2 : No",
    "enviarProv -> recibirProv",
    "recibirProv -> gwUneN2",
    "resolverN2 -> gwUneN2",
    "gwUneN2 -> pedirConf",
    "pedirConf -> confirmar",
    "confirmar -> gwConf",
    "gwConf -> cerrar : Sí",
    "gwConf -> diagN2 : No",
    "t48 -> cerrarAuto",
    "cerrar -> gwUneCierre",
    "cerrarAuto -> gwUneCierre",
    "gwUneCierre -> encuesta",
    "encuesta -> fin"
  ],
  "messageFlows": [
    "enviarProv -> Proveedor externo : Equipo y reporte de falla",
    "Proveedor externo -> recibirProv : Diagnóstico / reparación"
  ],
  "associations": ["registrar -> ticket", "registrar -> glpi", "notaPrio -> clasificar", "notaCanal -> reportar"]
}
