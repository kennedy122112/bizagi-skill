{
  "name": "Contratación CAS",
  "doc": "Contratación de personal bajo el régimen CAS, desde el requerimiento del área usuaria hasta el registro del contrato y la inducción del nuevo trabajador. Una convocatoria desierta termina este proceso; la nueva convocatoria es otro proceso.",
  "meta": {"codigo": "PR-RRHH-004", "version": "1.0", "responsable": "Jefatura de Recursos Humanos", "area": "Recursos Humanos"},
  "pools": [
    {"name": "Entidad", "lanes": ["Área usuaria", "Recursos Humanos", "Jefe de RRHH", "Presupuesto", "Comité de selección"]},
    {"name": "Postulantes", "blackbox": true}
  ],
  "nodes": [
    {"id": "inicio", "type": "start", "name": "Necesidad de personal", "lane": "Área usuaria"},
    {"id": "enviar_req", "type": "userTask", "name": "Enviar requerimiento de personal", "lane": "Área usuaria", "doc": "El área usuaria remite el requerimiento con los términos del perfil del puesto."},
    {"id": "revisar_req", "type": "userTask", "name": "Revisar requerimiento", "lane": "Recursos Humanos"},
    {"id": "solicitar_cert", "type": "userTask", "name": "Solicitar certificación presupuestal", "lane": "Recursos Humanos"},
    {"id": "evaluar_cert", "type": "userTask", "name": "Evaluar disponibilidad presupuestal", "lane": "Presupuesto"},
    {"id": "gw_cert", "type": "exclusive", "name": "¿Hay certificación?", "lane": "Presupuesto"},
    {"id": "fin_devuelto", "type": "end", "name": "Requerimiento devuelto", "lane": "Área usuaria"},
    {"id": "elaborar_bases", "type": "userTask", "name": "Elaborar bases", "lane": "Recursos Humanos"},
    {"id": "aprobar_bases", "type": "userTask", "name": "Aprobar bases", "lane": "Jefe de RRHH"},
    {"id": "par_pub", "type": "parallel", "name": "", "lane": "Recursos Humanos"},
    {"id": "pub_talento", "type": "userTask", "name": "Publicar convocatoria en Talento Perú", "lane": "Recursos Humanos"},
    {"id": "pub_web", "type": "userTask", "name": "Publicar convocatoria en web institucional", "lane": "Recursos Humanos"},
    {"id": "par_pub_fin", "type": "parallel", "name": "", "lane": "Recursos Humanos"},
    {"id": "recibir_cv", "type": "receiveTask", "name": "Recibir CV de postulantes", "lane": "Recursos Humanos", "doc": "Los postulantes envían su CV por la plataforma durante los 10 días hábiles de publicación."},
    {"id": "eval_curricular", "type": "userTask", "name": "Realizar evaluación curricular", "lane": "Comité de selección"},
    {"id": "gw_curr", "type": "exclusive", "name": "¿Algún postulante aprobó?", "lane": "Comité de selección"},
    {"id": "entrevista", "type": "userTask", "name": "Realizar entrevista personal", "lane": "Comité de selección"},
    {"id": "gw_entr", "type": "exclusive", "name": "¿Algún postulante aprobó la entrevista?", "lane": "Comité de selección"},
    {"id": "desierto", "type": "userTask", "name": "Declarar convocatoria desierta", "lane": "Comité de selección"},
    {"id": "fin_desierto", "type": "end", "name": "Convocatoria desierta", "lane": "Comité de selección"},
    {"id": "pub_result", "type": "sendTask", "name": "Publicar resultados", "lane": "Recursos Humanos"},
    {"id": "firmar", "type": "receiveTask", "name": "Suscribir contrato", "lane": "Recursos Humanos", "doc": "El ganador tiene 5 días hábiles para firmar el contrato."},
    {"id": "t_firma", "type": "timer", "name": "5 días hábiles sin firma", "attachedTo": "firmar", "timer": "P5D"},
    {"id": "gw_acc", "type": "exclusive", "name": "¿Hay accesitario?", "lane": "Recursos Humanos"},
    {"id": "convocar_acc", "type": "sendTask", "name": "Convocar al accesitario", "lane": "Recursos Humanos"},
    {"id": "par_cierre", "type": "parallel", "name": "", "lane": "Recursos Humanos"},
    {"id": "reg_airhsp", "type": "userTask", "name": "Registrar contrato en el AIRHSP", "lane": "Recursos Humanos"},
    {"id": "reg_planilla", "type": "userTask", "name": "Registrar trabajador en planilla", "lane": "Recursos Humanos"},
    {"id": "induccion", "type": "manualTask", "name": "Realizar inducción al nuevo trabajador", "lane": "Área usuaria"},
    {"id": "par_cierre_fin", "type": "parallel", "name": "", "lane": "Recursos Humanos"},
    {"id": "fin_ok", "type": "end", "name": "Trabajador contratado", "lane": "Recursos Humanos"},

    {"id": "d_req", "type": "dataObject", "name": "Requerimiento con perfil del puesto"},
    {"id": "d_cert", "type": "dataObject", "name": "Certificación presupuestal"},
    {"id": "d_bases", "type": "dataObject", "name": "Bases aprobadas"},
    {"id": "d_contrato", "type": "dataObject", "name": "Contrato CAS firmado"},
    {"id": "s_talento", "type": "dataStore", "name": "Talento Perú"},
    {"id": "s_airhsp", "type": "dataStore", "name": "AIRHSP"},
    {"id": "s_planilla", "type": "dataStore", "name": "Sistema de planillas"},
    {"id": "n_conv", "type": "annotation", "text": "La convocatoria se publica en Talento Perú por 10 días hábiles."},
    {"id": "n_firma", "type": "annotation", "text": "Plazo de firma: 5 días hábiles. Si no firma, se convoca al accesitario (segundo en orden de mérito)."},
    {"id": "n_desierto", "type": "annotation", "text": "Una nueva convocatoria es otro proceso."}
  ],
  "flows": [
    "inicio -> enviar_req",
    "enviar_req -> revisar_req",
    "revisar_req -> solicitar_cert",
    "solicitar_cert -> evaluar_cert",
    "evaluar_cert -> gw_cert",
    "gw_cert -> fin_devuelto : No",
    "gw_cert -> elaborar_bases : Sí",
    "elaborar_bases -> aprobar_bases",
    "aprobar_bases -> par_pub",
    "par_pub -> pub_talento",
    "par_pub -> pub_web",
    "pub_talento -> par_pub_fin",
    "pub_web -> par_pub_fin",
    "par_pub_fin -> recibir_cv",
    "recibir_cv -> eval_curricular",
    "eval_curricular -> gw_curr",
    "gw_curr -> entrevista : Sí",
    "gw_curr -> desierto : No",
    "entrevista -> gw_entr",
    "gw_entr -> pub_result : Sí",
    "gw_entr -> desierto : No",
    "desierto -> fin_desierto",
    "pub_result -> firmar",
    "t_firma -> gw_acc",
    "gw_acc -> convocar_acc : Sí",
    "gw_acc -> desierto : No",
    "convocar_acc -> firmar",
    "firmar -> par_cierre",
    "par_cierre -> reg_airhsp",
    "par_cierre -> induccion",
    "reg_airhsp -> reg_planilla",
    "reg_planilla -> par_cierre_fin",
    "induccion -> par_cierre_fin",
    "par_cierre_fin -> fin_ok"
  ],
  "messageFlows": [
    "pub_talento -> Postulantes : Convocatoria",
    "Postulantes -> recibir_cv : CV",
    "pub_result -> Postulantes : Resultados",
    "convocar_acc -> Postulantes : Convocatoria a firma",
    "Postulantes -> firmar : Contrato firmado"
  ],
  "associations": [
    "enviar_req -> d_req",
    "d_req -> revisar_req",
    "evaluar_cert -> d_cert",
    "aprobar_bases -> d_bases",
    "pub_talento -> s_talento",
    "firmar -> d_contrato",
    "reg_airhsp -> s_airhsp",
    "reg_planilla -> s_planilla",
    "n_conv -> pub_talento",
    "n_firma -> firmar",
    "n_desierto -> fin_desierto"
  ]
}
