<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Solicitud de compra" targetNamespace="http://bizagi-cli/bpmn" exporter="bizagi-cli" exporterVersion="0.2.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Empresa" name="Empresa" processRef="Process_Pool_Empresa" />
    <bpmn:participant id="Pool_Proveedor" name="Proveedor" processRef="Process_Pool_Proveedor" />
    <bpmn:messageFlow id="MsgFlow_1" name="Pedido de cotización" sourceRef="cotizar" targetRef="Pool_Proveedor" />
    <bpmn:messageFlow id="MsgFlow_2" name="Cotización" sourceRef="Pool_Proveedor" targetRef="espera" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Empresa" name="Empresa" isExecutable="false">
    <bpmn:documentation>Un colaborador solicita un bien; su jefe aprueba, Compras cotiza y Finanzas paga al proveedor.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Pool_Empresa">
      <bpmn:lane id="Lane_Pool_Empresa_Solicitante" name="Solicitante">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corregir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pool_Empresa_Jefe_de_area" name="Jefe de área">
        <bpmn:flowNodeRef>aprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_aprob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rechazo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pool_Empresa_Compras" name="Compras">
        <bpmn:flowNodeRef>cotizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recibir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pool_Empresa_Finanzas" name="Finanzas">
        <bpmn:flowNodeRef>pagar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Necesidad de compra">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="registrar" name="Registrar solicitud">
      <bpmn:documentation>Completa el formulario con el bien, la cantidad y la justificación.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="aprobar" name="Aprobar solicitud">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_aprob" name="¿Aprobada?" default="Flow_4">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="corregir" name="Corregir solicitud">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="rechazo" name="Solicitud rechazada">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="cotizar" name="Solicitar cotización">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="espera" name="Cotización recibida">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="espera_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="orden" name="Emitir orden de compra">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="par1" name="">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="recibir" name="Recibir bien">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="pagar" name="Programar pago">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="par2" name="">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="fin" name="Compra completada">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="inicio" targetRef="registrar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="registrar" targetRef="aprobar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="aprobar" targetRef="gw_aprob" />
    <bpmn:sequenceFlow id="Flow_4" name="Sí" sourceRef="gw_aprob" targetRef="cotizar" />
    <bpmn:sequenceFlow id="Flow_5" name="Observada" sourceRef="gw_aprob" targetRef="corregir" />
    <bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="gw_aprob" targetRef="rechazo" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="corregir" targetRef="aprobar" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="cotizar" targetRef="espera" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="espera" targetRef="orden" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="orden" targetRef="par1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="par1" targetRef="recibir" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="par1" targetRef="pagar" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="recibir" targetRef="par2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="pagar" targetRef="par2" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="par2" targetRef="fin" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Proveedor" name="Proveedor" isExecutable="false" />
  <bpmndi:BPMNDiagram id="Diagram_1" name="Solicitud de compra">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Pool_Empresa_di" bpmnElement="Pool_Empresa" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1830" height="536" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pool_Empresa_Solicitante_di" bpmnElement="Lane_Pool_Empresa_Solicitante" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1800" height="134" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pool_Empresa_Jefe_de_area_di" bpmnElement="Lane_Pool_Empresa_Jefe_de_area" isHorizontal="true">
        <dc:Bounds x="50" y="154" width="1800" height="134" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pool_Empresa_Compras_di" bpmnElement="Lane_Pool_Empresa_Compras" isHorizontal="true">
        <dc:Bounds x="50" y="288" width="1800" height="134" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pool_Empresa_Finanzas_di" bpmnElement="Lane_Pool_Empresa_Finanzas" isHorizontal="true">
        <dc:Bounds x="50" y="422" width="1800" height="134" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Proveedor_di" bpmnElement="Pool_Proveedor" isHorizontal="true">
        <dc:Bounds x="20" y="626" width="1830" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="132" y="69" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="109" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
