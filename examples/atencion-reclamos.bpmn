<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Atención de reclamos" targetNamespace="http://bizagi-cli/bpmn" exporter="bizagi-cli" exporterVersion="0.2.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Entidad" name="Entidad" processRef="Process_Pool_Entidad" />
    <bpmn:participant id="Pool_Ciudadano" name="Ciudadano" processRef="Process_Pool_Ciudadano" />
    <bpmn:messageFlow id="MsgFlow_1" name="Reclamo" sourceRef="Pool_Ciudadano" targetRef="inicio" />
    <bpmn:messageFlow id="MsgFlow_2" name="Respuesta" sourceRef="notificar" targetRef="Pool_Ciudadano" />
    <bpmn:messageFlow id="MsgFlow_3" name="Improcedencia" sourceRef="improcedente" targetRef="Pool_Ciudadano" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Entidad" name="Entidad" isExecutable="false">
    <bpmn:documentation>El ciudadano presenta un reclamo; Mesa de partes lo registra, el área responsable lo evalúa y responde dentro del plazo.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Pool_Entidad">
      <bpmn:lane id="Lane_Pool_Entidad_Mesa_de_partes" name="Mesa de partes">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clasificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>improcedente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_improc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fallo_envio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notif_fisica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pool_Entidad_Area_responsable" name="Área responsable">
        <bpmn:flowNodeRef>evaluar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordatorio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vencido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redactar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pool_Entidad_Jefatura" name="Jefatura">
        <bpmn:flowNodeRef>alertar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_alerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>escalar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Reclamo recibido">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="inicio_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="registrar" name="Registrar reclamo">
      <bpmn:documentation>Registra el reclamo en el libro de reclamaciones y asigna número de expediente.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="clasificar" name="Clasificar reclamo">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw_tipo" name="¿Procede?" default="Flow_4">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="improcedente" name="Notificar improcedencia">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="fin_improc" name="Reclamo improcedente">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="evaluar" name="Evaluar reclamo">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="recordatorio" name="10 días sin respuesta" attachedToRef="evaluar" cancelActivity="false">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="recordatorio_def">
        <bpmn:timeDuration>P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="alertar" name="Alertar a jefatura">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="fin_alerta" name="Alerta enviada">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="vencido" name="Plazo vencido (30 días)" attachedToRef="evaluar" cancelActivity="true">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="vencido_def">
        <bpmn:timeDuration>P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="escalar" name="Resolver por jefatura">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="redactar" name="Redactar respuesta">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="notificar" name="Notificar respuesta">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="fallo_envio" name="Error de envío" attachedToRef="notificar" cancelActivity="true">
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:errorEventDefinition id="fallo_envio_def" />
    </bpmn:boundaryEvent>
    <bpmn:manualTask id="notif_fisica" name="Notificar en físico">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="fin" name="Reclamo atendido">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="doc_reclamo" name="Hoja de reclamo" />
    <bpmn:dataStoreReference id="bd" name="Libro de reclamaciones" />
    <bpmn:dataObject id="doc_resp" name="Carta de respuesta" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="inicio" targetRef="registrar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="registrar" targetRef="clasificar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="clasificar" targetRef="gw_tipo" />
    <bpmn:sequenceFlow id="Flow_4" name="Sí" sourceRef="gw_tipo" targetRef="evaluar" />
    <bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="gw_tipo" targetRef="improcedente" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="improcedente" targetRef="fin_improc" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="evaluar" targetRef="redactar" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="recordatorio" targetRef="alertar" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="alertar" targetRef="fin_alerta" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="vencido" targetRef="escalar" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="escalar" targetRef="notificar" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="redactar" targetRef="notificar" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="notificar" targetRef="fin" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="fallo_envio" targetRef="notif_fisica" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="notif_fisica" targetRef="fin" />
    <bpmn:textAnnotation id="nota">
      <bpmn:text>Plazo legal: 30 días hábiles</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="doc_reclamo" targetRef="registrar" associationDirection="One" />
    <bpmn:association id="Assoc_2" sourceRef="registrar" targetRef="bd" associationDirection="One" />
    <bpmn:association id="Assoc_3" sourceRef="redactar" targetRef="doc_resp" associationDirection="One" />
    <bpmn:association id="Assoc_4" sourceRef="nota" targetRef="evaluar" associationDirection="None" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Ciudadano" name="Ciudadano" isExecutable="false" />
  <bpmndi:BPMNDiagram id="Diagram_1" name="Atención de reclamos">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
